@model SecurityPatrol.Web.ViewModels.FloorPlanViewerViewModel
@{
    ViewData["Title"] = Model.FloorPlan.Label ?? Model.FloorPlan.OriginalFileName;
    var isPdf = Model.FloorPlan.FileType == "pdf";
    var pinnedLocations = Model.Locations.Where(l => l.MapX.HasValue && l.MapY.HasValue).ToList();
}

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-0">
                <i class="fas fa-map me-2"></i>@(Model.FloorPlan.Label ?? Model.FloorPlan.OriginalFileName)
            </h2>
            <small class="opacity-75">@Model.FloorPlan.Floor.Name &mdash; @Model.FloorPlan.Floor.Building.Name</small>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.IsInRole("Administrator"))
            {
                <a href="/Admin/FloorPlanEditor/@Model.FloorPlan.Id" class="btn btn-light">
                    <i class="fas fa-edit me-1"></i>Edit Map
                </a>
            }
            @await Html.PartialAsync("_DashboardButton")
        </div>
    </div>
</div>

<div class="container-fluid px-3 px-md-4">

    <!-- Map Container -->
    <div class="mb-4">
        <div id="mapWrapper" style="position:relative; width:100%; max-width:1200px; margin:0 auto;">
            @if (isPdf)
            {
                <canvas id="pdfCanvas" style="width:100%; height:auto; display:block; border-radius:8px; box-shadow:0 2px 12px rgba(0,0,0,0.15);"></canvas>
            }
            else
            {
                <img id="floorPlanImg" src="/uploads/floorplans/@Model.FloorPlan.StoredFileName"
                     style="width:100%; display:block; border-radius:8px; box-shadow:0 2px 12px rgba(0,0,0,0.15);"
                     alt="Floor Plan" />
            }
            <svg id="mapOverlay" style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none;"></svg>
        </div>
    </div>

    <!-- Location Legend -->
    @if (pinnedLocations.Any())
    {
        <div class="card border-0 shadow-sm mb-4" style="max-width:1200px; margin:0 auto;">
            <div class="card-header fw-semibold" style="background:#003087; color:white;">
                <i class="fas fa-list me-2"></i>Checkpoint Legend
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    @{
                        int idx = 1;
                    }
                    @foreach (var loc in pinnedLocations)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="d-flex align-items-start p-3 border-bottom border-end">
                                <span class="badge rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3"
                                      style="background:#003087; color:white; width:28px; height:28px; font-size:12px; font-weight:bold;">
                                    @idx
                                </span>
                                <div class="min-w-0">
                                    <div class="fw-semibold small">@loc.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(loc.Description))
                                    {
                                        <div class="text-muted" style="font-size:0.78rem;">@loc.Description</div>
                                    }
                                </div>
                            </div>
                        </div>
                        idx++;
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4" style="max-width:1200px; margin:0 auto;">
            <div class="card-body text-center py-4 text-muted">
                <i class="fas fa-map-pin fa-2x mb-2 opacity-25"></i>
                <p class="mb-0 small">No checkpoints have been mapped to this floor plan yet.</p>
            </div>
        </div>
    }

</div>

@if (isPdf)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
}

@section Scripts {
    <script>
        var pins = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Locations
                .Where(l => l.MapX.HasValue && l.MapY.HasValue)
                .Select(l => new {
                    id          = l.Id,
                    name        = l.Name,
                    description = l.Description ?? "",
                    qrCode      = l.QrCode,
                    x           = l.MapX,
                    y           = l.MapY
                })
        ));

        var fileType = '@Html.Raw(Model.FloorPlan.FileType)';
        var pinRadius = @Model.FloorPlan.PinRadius;

        var segmentWaypoints = {};
        (function() {
            var raw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Waypoints,
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            raw.forEach(function(w) {
                var key = w.fromLocationId + '-' + w.toLocationId;
                if (!segmentWaypoints[key]) segmentWaypoints[key] = [];
                segmentWaypoints[key][w.orderIndex] = { x: w.x, y: w.y };
            });
            Object.keys(segmentWaypoints).forEach(function(k) {
                segmentWaypoints[k] = segmentWaypoints[k].filter(Boolean);
            });
        })();

        function clipToward(from, to, dist) {
            var dx = to.x - from.x, dy = to.y - from.y;
            var len = Math.sqrt(dx * dx + dy * dy);
            if (len < 1) return { x: from.x, y: from.y };
            return { x: from.x + dx / len * dist, y: from.y + dy / len * dist };
        }

        function smoothPath(pts) {
            if (pts.length < 2) return '';
            if (pts.length === 2)
                return 'M ' + pts[0].x.toFixed(1) + ' ' + pts[0].y.toFixed(1) +
                       ' L ' + pts[1].x.toFixed(1) + ' ' + pts[1].y.toFixed(1);
            var ps = [pts[0]].concat(pts).concat([pts[pts.length - 1]]);
            var d = 'M ' + ps[1].x.toFixed(1) + ' ' + ps[1].y.toFixed(1);
            for (var i = 1; i < ps.length - 2; i++) {
                var p0 = ps[i - 1], p1 = ps[i], p2 = ps[i + 1], p3 = ps[i + 2];
                var cp1x = p1.x + (p2.x - p0.x) / 6;
                var cp1y = p1.y + (p2.y - p0.y) / 6;
                var cp2x = p2.x - (p3.x - p1.x) / 6;
                var cp2y = p2.y - (p3.y - p1.y) / 6;
                d += ' C ' + cp1x.toFixed(1) + ' ' + cp1y.toFixed(1) +
                     ' ' + cp2x.toFixed(1) + ' ' + cp2y.toFixed(1) +
                     ' ' + p2.x.toFixed(1) + ' ' + p2.y.toFixed(1);
            }
            return d;
        }

        function renderArrows(svg, w, h) {
            var defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
            var marker = document.createElementNS('http://www.w3.org/2000/svg', 'marker');
            marker.setAttribute('id', 'patrol-arrow-v');
            marker.setAttribute('viewBox', '0 0 10 8');
            marker.setAttribute('refX', '9');
            marker.setAttribute('refY', '4');
            marker.setAttribute('markerWidth', '10');
            marker.setAttribute('markerHeight', '8');
            marker.setAttribute('orient', 'auto');
            marker.setAttribute('markerUnits', 'userSpaceOnUse');
            var poly = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            poly.setAttribute('d', 'M 0 0 L 10 4 L 0 8 z');
            poly.setAttribute('fill', '#0d6efd');
            marker.appendChild(poly);
            defs.appendChild(marker);
            svg.appendChild(defs);

            var arrowOffset = pinRadius + 10;
            for (var i = 0; i < pins.length - 1; i++) {
                var pA = pins[i], pB = pins[i + 1];
                var key = pA.id + '-' + pB.id;
                var wpts = (segmentWaypoints[key] || []).map(function(wp) {
                    return { x: wp.x * w, y: wp.y * h };
                });
                var all = [{ x: pA.x * w, y: pA.y * h }].concat(wpts).concat([{ x: pB.x * w, y: pB.y * h }]);
                var pStart = clipToward(all[0], all[1] || all[0], pinRadius + 2);
                var last = all.length - 1;
                var pEnd = clipToward(all[last], all[last - 1] || all[last], arrowOffset);
                var dx = pEnd.x - pStart.x, dy = pEnd.y - pStart.y;
                if (wpts.length === 0 && Math.sqrt(dx * dx + dy * dy) < 5) continue;
                var pts = [pStart].concat(wpts).concat([pEnd]);
                var pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                pathEl.setAttribute('d', smoothPath(pts));
                pathEl.setAttribute('stroke', '#0d6efd');
                pathEl.setAttribute('stroke-width', '2');
                pathEl.setAttribute('fill', 'none');
                pathEl.setAttribute('marker-end', 'url(#patrol-arrow-v)');
                pathEl.setAttribute('pointer-events', 'none');
                svg.appendChild(pathEl);
            }
        }

        function renderPins() {
            var svg     = document.getElementById('mapOverlay');
            var wrapper = document.getElementById('mapWrapper');
            if (!svg || !wrapper) return;

            var w = wrapper.offsetWidth, h = wrapper.offsetHeight;
            svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
            svg.innerHTML = '';

            if (pins.length >= 2) renderArrows(svg, w, h);

            pins.forEach(function(pin, i) {
                var cx = pin.x * w;
                var cy = pin.y * h;

                var g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                g.setAttribute('style', 'cursor:pointer; pointer-events:all;');
                g.setAttribute('class', 'map-pin-view');

                var circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                circle.setAttribute('cx', cx);
                circle.setAttribute('cy', cy);
                circle.setAttribute('r', pinRadius);
                circle.setAttribute('fill', '#003087');
                circle.setAttribute('stroke', 'white');
                circle.setAttribute('stroke-width', '2');

                var text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('x', cx);
                text.setAttribute('y', cy + pinRadius * 0.28);
                text.setAttribute('text-anchor', 'middle');
                text.setAttribute('fill', 'white');
                text.setAttribute('font-size', Math.round(pinRadius * 0.67));
                text.setAttribute('font-weight', 'bold');
                text.textContent = (i + 1).toString();

                var title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                title.textContent = pin.name + (pin.description ? '\n' + pin.description : '');

                g.appendChild(circle);
                g.appendChild(text);
                g.appendChild(title);
                svg.appendChild(g);
            });
        }

        if (fileType === 'pdf') {
            var pdfjsLib = window['pdfjs-dist/build/pdf'];
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
            pdfjsLib.getDocument('/uploads/floorplans/@Model.FloorPlan.StoredFileName').promise.then(function(pdf) {
                pdf.getPage(1).then(function(page) {
                    var scale    = 2;
                    var viewport = page.getViewport({ scale: scale });
                    var canvas   = document.getElementById('pdfCanvas');
                    canvas.width  = viewport.width;
                    canvas.height = viewport.height;
                    canvas.style.width  = '100%';
                    canvas.style.height = 'auto';
                    page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise.then(function () {
                        requestAnimationFrame(renderPins);
                    });
                });
            });
        } else {
            var img = document.getElementById('floorPlanImg');
            if (img) {
                if (img.complete) {
                    renderPins();
                } else {
                    img.addEventListener('load', renderPins);
                }
            }
        }

        var resizeTimer;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(renderPins, 100);
        });
    </script>
}
