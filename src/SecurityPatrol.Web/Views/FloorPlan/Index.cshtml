@model SecurityPatrol.Web.ViewModels.FloorPlanListViewModel
@{
    ViewData["Title"] = "Floor Maps";
}

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-map me-2"></i>Floor Maps</h2>
            <small class="opacity-75">View building floor plan maps</small>
        </div>
        @await Html.PartialAsync("_DashboardButton")
    </div>
</div>

<div class="container">

    @if (!Model.Buildings.Any() || !Model.Buildings.SelectMany(b => b.Floors).SelectMany(f => f.Plans).Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-map fa-3x mb-3 opacity-25"></i>
            <p class="mb-0">No floor plans available yet.</p>
        </div>
    }
    else
    {
        @foreach (var buildingGroup in Model.Buildings)
        {
            <div class="mb-5">
                <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                    <i class="fas fa-building me-2" style="color:#003087;"></i>
                    <div>
                        <h4 class="mb-0 fw-bold">@buildingGroup.Building.Name</h4>
                        @if (!string.IsNullOrWhiteSpace(buildingGroup.Building.Address))
                        {
                            <small class="text-muted">@buildingGroup.Building.Address</small>
                        }
                    </div>
                </div>

                @foreach (var floorGroup in buildingGroup.Floors)
                {
                    <div class="mb-4 ms-3">
                        <h5 class="fw-semibold mb-3">
                            <i class="fas fa-layer-group me-2 text-secondary"></i>@floorGroup.Floor.Name
                        </h5>

                        @if (!floorGroup.Plans.Any())
                        {
                            <p class="text-muted ms-3 small">No floor plans for this floor.</p>
                        }
                        else
                        {
                            <div class="row g-3 ms-1">
                                @foreach (var plan in floorGroup.Plans)
                                {
                                    var pinnedCount = plan.Locations.Count(l => l.MapX.HasValue);
                                    <div class="col-md-4 col-sm-6">
                                        <div class="card h-100 border-0 shadow-sm">
                                            <div class="card-img-top d-flex align-items-center justify-content-center bg-light"
                                                 style="height:160px; overflow:hidden; border-radius: 0.375rem 0.375rem 0 0;">
                                                @if (plan.FileType == "pdf")
                                                {
                                                    <i class="fas fa-file-pdf fa-4x" style="color:#c0392b; opacity:0.7;"></i>
                                                }
                                                else
                                                {
                                                    <img src="/uploads/floorplans/@plan.StoredFileName"
                                                         alt="@(plan.Label ?? plan.OriginalFileName)"
                                                         style="width:100%; height:100%; object-fit:cover;" />
                                                }
                                            </div>
                                            <div class="card-body d-flex flex-column">
                                                <h6 class="card-title fw-bold mb-1">
                                                    @(plan.Label ?? plan.OriginalFileName)
                                                </h6>
                                                <p class="card-text small text-muted mb-3">
                                                    <i class="fas fa-map-pin me-1"></i>
                                                    @pinnedCount checkpoint(s) mapped
                                                </p>
                                                <div class="mt-auto">
                                                    <a href="/FloorPlan/View/@plan.Id" class="btn btn-primary btn-sm w-100">
                                                        <i class="fas fa-map me-1"></i>View Map
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }

</div>
