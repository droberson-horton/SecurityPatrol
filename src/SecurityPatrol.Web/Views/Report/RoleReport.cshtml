@model SecurityPatrol.Web.ViewModels.RoleReportViewModel
@using SecurityPatrol.Web.Models
@{
    ViewData["Title"] = "Role Report";
}

<div class="page-header no-print">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-users me-2"></i>Role Report</h2>
            <small class="opacity-75">Users by role with walk activity</small>
        </div>
        <div class="d-flex gap-2 no-print">
            @await Html.PartialAsync("_DashboardButton")
            <button onclick="window.print()" class="btn btn-light">
                <i class="fas fa-print me-1"></i>Print
            </button>
        </div>
    </div>
</div>

<div class="container">
    @foreach (var group in Model.Groups)
    {
        @if (!group.Users.Any()) { continue; }
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center"
                 style="background: @(group.Role == UserRole.Administrator ? "#dc3545" : group.Role == UserRole.Auditor ? "#0dcaf0" : "#003087"); color:white;">
                <h6 class="mb-0">
                    <i class="fas @(group.Role == UserRole.Administrator ? "fa-shield-halved" : group.Role == UserRole.Auditor ? "fa-search" : "fa-user-shield") me-2"></i>
                    @group.Role
                    <span class="badge bg-white text-dark ms-2">@group.Users.Count</span>
                </h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Total Patrols</th>
                            <th>Completed</th>
                            <th>Completion Rate</th>
                            <th>Last Patrol</th>
                            <th>Member Since</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in group.Users)
                        {
                            var completionRate = user.TotalPatrols > 0 ? (double)user.CompletedPatrols / user.TotalPatrols * 100 : 0;
                            <tr>
                                <td class="fw-semibold">@user.FullName</td>
                                <td class="small text-muted">@user.Email</td>
                                <td>
                                    <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-center">@user.TotalPatrols</td>
                                <td class="text-center">@user.CompletedPatrols</td>
                                <td>
                                    @if (user.TotalPatrols > 0)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:8px;">
                                                <div class="progress-bar @(completionRate >= 80 ? "bg-success" : completionRate >= 50 ? "bg-warning" : "bg-danger")"
                                                     style="width:@completionRate%"></div>
                                            </div>
                                            <span class="small">@completionRate.ToString("0")%</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td class="small">@(user.LastPatrolDate?.ToLocalTime().ToString("MM/dd/yyyy") ?? "-")</td>
                                <td class="small text-muted">@user.CreatedAt.ToString("MM/dd/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
