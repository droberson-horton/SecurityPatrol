@model SecurityPatrol.Web.ViewModels.HistoryReportViewModel
@using SecurityPatrol.Web.Models
@{
    ViewData["Title"] = "Patrol History Report";
}

<div class="page-header no-print">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-history me-2"></i>Patrol History Report</h2>
            <small class="opacity-75">@Model.TotalPatrols patrols found</small>
        </div>
        <div class="d-flex gap-2">
            @await Html.PartialAsync("_DashboardButton")
            <a href="@(Context.Request.Path)?@(Context.Request.QueryString.Value?.TrimStart('?'))&export=true"
               class="btn btn-light">
                <i class="fas fa-file-csv me-1"></i>Export CSV
            </a>
            <button onclick="window.print()" class="btn btn-light">
                <i class="fas fa-print me-1"></i>Print
            </button>
        </div>
    </div>
</div>

<div class="container">
    <div class="card mb-4 no-print">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Officer</label>
                    <select name="officerId" class="form-select form-select-sm">
                        <option value="">All Officers</option>
                        @foreach (var o in Model.Officers)
                        {
                            <option value="@o.Id" selected="@(Model.OfficerFilter == o.Id)">@o.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">From</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm"
                           value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">To</label>
                    <input type="date" name="toDate" class="form-control form-control-sm"
                           value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Status</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">All</option>
                        @foreach (var s in Enum.GetValues<PatrolStatus>())
                        {
                            <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill">Apply</button>
                    <a href="/Report/History" class="btn btn-outline-secondary btn-sm flex-fill">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm">
                <div class="card-body py-3">
                    <div class="fs-4 fw-bold">@Model.TotalPatrols</div>
                    <div class="small text-muted">Total Patrols</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm">
                <div class="card-body py-3">
                    <div class="fs-4 fw-bold text-success">@Model.CompletedPatrols</div>
                    <div class="small text-muted">Completed</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm">
                <div class="card-body py-3">
                    <div class="fs-4 fw-bold text-danger">@Model.IncompletePatrols</div>
                    <div class="small text-muted">Incomplete</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm">
                <div class="card-body py-3">
                    <div class="fs-4 fw-bold text-primary">@Model.TotalLocationsScanned</div>
                    <div class="small text-muted">Locations Scanned</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header" style="background:#003087; color:white;">
            <h6 class="mb-0"><i class="fas fa-table me-2"></i>Walk Details</h6>
        </div>
        <div class="card-body p-0">
            @if (Model.Patrols.Any())
            {
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Officer</th>
                            <th>Route</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Duration</th>
                            <th>Scanned</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patrol in Model.Patrols)
                        {
                            var duration = patrol.Duration;
                            <tr style="cursor:pointer;" onclick="window.location='/Report/Detail/@patrol.PatrolId'">
                                <td class="small text-muted">#@patrol.PatrolId</td>
                                <td class="small fw-semibold">@patrol.OfficerName</td>
                                <td class="small">@(patrol.RouteName ?? "Ad-hoc")</td>
                                <td class="small">@patrol.StartTime.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                <td class="small">@(patrol.EndTime?.ToLocalTime().ToString("MM/dd HH:mm") ?? "-")</td>
                                <td class="small">
                                    @if (duration.HasValue)
                                    {
                                        @($"{(int)duration.Value.TotalMinutes}m")
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td class="small">@patrol.ScannedCount / @patrol.TotalLocations</td>
                                <td>
                                    <span class="badge @(patrol.Status == PatrolStatus.Completed ? "bg-success" : patrol.Status == PatrolStatus.InProgress ? "bg-warning text-dark" : "bg-danger") small">
                                        @patrol.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-chart-bar fa-3x mb-3 opacity-25"></i>
                    <p>No patrols match the selected criteria.</p>
                </div>
            }
        </div>
    </div>
</div>
