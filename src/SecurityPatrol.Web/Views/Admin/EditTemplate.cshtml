@model SecurityPatrol.Web.Models.ScheduleTemplate
@using SecurityPatrol.Web.Models
@{
    ViewData["Title"] = "Edit Template";
    var routes = ViewBag.Routes as List<PatrolRoute> ?? new List<PatrolRoute>();
}

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-clipboard-list me-2"></i>Edit Template: @Model.Name</h2>
            <small class="opacity-75">Manage time slots for this schedule template</small>
        </div>
        <a href="/Admin/ScheduleTemplates" class="btn btn-outline-light">
            <i class="fas fa-arrow-left me-1"></i>Back to Templates
        </a>
    </div>
</div>

<div class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header" style="background:#003087; color:white;">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Template Details</h6>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="SaveTemplate">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" required maxlength="200" value="@Model.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="description" class="form-control" rows="3" maxlength="1000">@Model.Description</textarea>
                        </div>
                        <div class="form-check mb-3">
                            <input type="checkbox" name="isActive" value="true" class="form-check-input" id="templateIsActive"
                                   @(Model.IsActive ? "checked" : "") />
                            <label class="form-check-label" for="templateIsActive">Active</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-save me-1"></i>Save Details
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center" style="background:#003087; color:white;">
                    <h6 class="mb-0"><i class="fas fa-clock me-2"></i>Time Slots (@Model.Slots.Count)</h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.Slots.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Label</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Route</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slot in Model.Slots.OrderBy(s => s.OrderIndex))
                                {
                                    <tr>
                                        <td class="text-muted small">@slot.OrderIndex</td>
                                        <td class="fw-semibold small">@slot.Label</td>
                                        <td class="small">@slot.StartTime.ToString(@"hh\:mm")</td>
                                        <td class="small">@slot.EndTime.ToString(@"hh\:mm")</td>
                                        <td class="small">
                                            @if (slot.PatrolRoute != null)
                                            {
                                                @slot.PatrolRoute.Name
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                                    data-bs-toggle="modal" data-bs-target="#editSlotModal"
                                                    data-slot-id="@slot.Id"
                                                    data-label="@slot.Label"
                                                    data-start="@slot.StartTime.ToString(@"hh\:mm")"
                                                    data-end="@slot.EndTime.ToString(@"hh\:mm")"
                                                    data-route-id="@(slot.PatrolRouteId?.ToString() ?? "")">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <form method="post" asp-action="DeleteTemplateSlot" class="d-inline"
                                                  onsubmit="return confirm('Delete this slot?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="slotId" value="@slot.Id" />
                                                <input type="hidden" name="templateId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-clock fa-2x mb-2 opacity-25"></i>
                            <p class="small">No slots yet. Add one below.</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header" style="background:#003087; color:white;">
                    <h6 class="mb-0"><i class="fas fa-plus me-2"></i>Add Time Slot</h6>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="AddTemplateSlot">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="templateId" value="@Model.Id" />
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Label <span class="text-danger">*</span></label>
                                <input type="text" name="label" class="form-control" required maxlength="200"
                                       placeholder="e.g. Morning Patrol" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Start Time <span class="text-danger">*</span></label>
                                <input type="time" name="startTime" class="form-control" required value="08:00" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">End Time <span class="text-danger">*</span></label>
                                <input type="time" name="endTime" class="form-control" required value="09:00" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Patrol Route</label>
                                <select name="patrolRouteId" class="form-select">
                                    <option value="">-- None --</option>
                                    @foreach (var r in routes)
                                    {
                                        <option value="@r.Id">@r.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-plus me-1"></i>Add Slot
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Slot Modal -->
<div class="modal fade" id="editSlotModal" tabindex="-1" aria-labelledby="editSlotModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="UpdateTemplateSlot">
                @Html.AntiForgeryToken()
                <input type="hidden" name="slotId" id="editSlotId" />
                <input type="hidden" name="templateId" value="@Model.Id" />
                <div class="modal-header" style="background:#003087; color:white;">
                    <h5 class="modal-title" id="editSlotModalLabel">
                        <i class="fas fa-pencil-alt me-2"></i>Edit Time Slot
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Label <span class="text-danger">*</span></label>
                        <input type="text" name="label" id="editSlotLabel" class="form-control" required maxlength="200" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Start Time <span class="text-danger">*</span></label>
                            <input type="time" name="startTime" id="editSlotStart" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">End Time <span class="text-danger">*</span></label>
                            <input type="time" name="endTime" id="editSlotEnd" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Patrol Route</label>
                        <select name="patrolRouteId" id="editSlotRoute" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var r in routes)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editSlotModal').addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            document.getElementById('editSlotId').value    = btn.dataset.slotId;
            document.getElementById('editSlotLabel').value = btn.dataset.label;
            document.getElementById('editSlotStart').value = btn.dataset.start;
            document.getElementById('editSlotEnd').value   = btn.dataset.end;

            var routeSelect = document.getElementById('editSlotRoute');
            routeSelect.value = btn.dataset.routeId || '';
        });
    </script>
}
