@model SecurityPatrol.Web.ViewModels.FloorPlanEditorViewModel
@{
    ViewData["Title"] = "Map Editor";
}

@section Styles {
<style>
    .map-pin { transition: opacity 0.1s; }
    .map-pin:hover circle { opacity: 0.85; }
    .unmapped-item:hover { background: #e9ecef !important; }
    body { overflow: hidden; }
</style>
}

<div class="page-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-map-marked-alt me-2"></i>Map Editor</h2>
            <small class="opacity-75">@(Model.FloorPlan.Label ?? Model.FloorPlan.OriginalFileName) &mdash; @Model.FloorPlan.Floor.Name, @Model.FloorPlan.Floor.Building.Name</small>
        </div>
        <div class="d-flex gap-2">
            @await Html.PartialAsync("_DashboardButton")
            @{
                var backUrl = Context.Request.Query["returnUrl"].ToString();
                if (string.IsNullOrEmpty(backUrl)) backUrl = "javascript:history.back()";
            }
            <a href="@backUrl" class="btn btn-light"><i class="fas fa-arrow-left me-1"></i>Back</a>
            <a href="/FloorPlan/View/@Model.FloorPlan.Id" class="btn btn-light"><i class="fas fa-eye me-1"></i>Preview</a>
            <button type="button" class="btn btn-danger" onclick="confirmDeleteFloorPlan()"><i class="fas fa-trash me-1"></i>Delete Floor Plan</button>
            <form id="deleteFloorPlanForm" action="/Admin/DeleteFloorPlan?id=@Model.FloorPlan.Id" method="post" style="display:none;">
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>
</div>

<form id="csrfForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div id="editorOuter" class="d-flex" style="overflow:hidden;">

    <!-- ── Sidebar ── -->
    <div id="editorSidebar" style="width:280px; min-width:280px; background:#f8f9fa; border-right:1px solid #dee2e6; display:flex; flex-direction:column; min-height:0;">

    <!-- Scrollable panel content -->
    <div style="flex:1; overflow-y:auto; min-height:0;">

        <!-- Mode toggle -->
        <div class="p-3 border-bottom">
            <label class="form-label small fw-semibold text-muted">EDIT MODE</label>
            <div class="btn-group w-100">
                <button id="btnModeAdd" class="btn btn-outline-primary active" onclick="setMode('add')">
                    <i class="fas fa-plus me-1"></i>Add Pin
                </button>
                <button id="btnModeSelect" class="btn btn-outline-secondary" onclick="setMode('select')">
                    <i class="fas fa-mouse-pointer me-1"></i>Select
                </button>
                <button id="btnModeRoute" class="btn btn-outline-success" onclick="setMode('route')">
                    <i class="fas fa-route me-1"></i>Route
                </button>
            </div>
        </div>

        <!-- Pin size -->
        <div class="p-3 border-bottom">
            <label class="form-label small fw-semibold text-muted">PIN SIZE</label>
            <div class="d-flex align-items-center gap-2 mb-2">
                <input type="range" id="pinSizeSlider" class="form-range flex-fill" min="8" max="40" value="@Model.FloorPlan.PinRadius" oninput="onPinSizeChange(parseInt(this.value));" />
            </div>
            <div class="d-flex align-items-center gap-1">
                <button class="btn btn-sm btn-outline-secondary" onclick="onPinSizeChange(Math.max(8, pinRadius - 1));" type="button"><i class="fas fa-minus"></i></button>
                <input type="number" id="pinSizeNumber" class="form-control form-control-sm text-center" min="8" max="40" value="@Model.FloorPlan.PinRadius"
                       oninput="onPinSizeChange(Math.min(40, Math.max(8, parseInt(this.value) || 8)));" style="width:64px;" />
                <button class="btn btn-sm btn-outline-secondary" onclick="onPinSizeChange(Math.min(40, pinRadius + 1));" type="button"><i class="fas fa-plus"></i></button>
            </div>
        </div>

        <!-- Unmapped locations -->
        <div class="p-3 border-bottom">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label small fw-semibold text-muted mb-0">UNMAPPED LOCATIONS</label>
                <span class="badge bg-secondary" id="unmappedCount">@Model.UnmappedLocations.Count</span>
            </div>
            <p class="small text-muted mb-2">Click a location then click the map to place it, or switch to Add mode to create new pins.</p>
            <div id="unmappedList">
                @foreach (var loc in Model.UnmappedLocations)
                {
                    <div class="unmapped-item p-2 mb-1 rounded border bg-white small"
                         data-id="@loc.Id" data-name="@loc.Name" data-desc="@(loc.Description ?? "")"
                         style="cursor:pointer;" onclick="selectUnmapped(this)">
                        <i class="fas fa-map-marker text-muted me-1"></i>@loc.Name
                        @if (!string.IsNullOrEmpty(loc.Description))
                        {
                            <div class="text-muted" style="font-size:10px;">@loc.Description</div>
                        }
                    </div>
                }
                @if (!Model.UnmappedLocations.Any())
                {
                    <div class="text-muted small fst-italic">All floor locations are mapped.</div>
                }
            </div>
        </div>

        <!-- Selected pin edit panel -->
        <div id="selectedPanel" class="p-3 d-none">
            <label class="form-label small fw-semibold text-muted">SELECTED PIN</label>
            <div class="mb-2">
                <label class="form-label small">Name <span class="text-danger">*</span></label>
                <input type="text" id="editName" class="form-control form-control-sm" maxlength="200" />
            </div>
            <div class="mb-2">
                <label class="form-label small">Description</label>
                <textarea id="editDesc" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-primary flex-fill" onclick="saveSelectedPin()"><i class="fas fa-save me-1"></i>Save</button>
                <button class="btn btn-sm btn-outline-danger" onclick="removeSelectedPin()"><i class="fas fa-times"></i></button>
            </div>
            <div class="mt-2 small text-muted" id="selectedQr"></div>
        </div>

    </div><!-- /scrollable content -->

        <!-- Status bar — fixed at bottom of sidebar, always visible -->
        <div class="p-3 border-top" style="flex-shrink:0;">
            <div id="statusMsg" class="small text-muted">Click on the map to add a pin.</div>
        </div>

    </div><!-- /editorSidebar -->

    <!-- ── Map area ── -->
    <div style="flex:1; display:flex; flex-direction:column; overflow:hidden; min-height:0;">

        <!-- Zoom toolbar -->
        <div style="padding:5px 12px; background:#f8f9fa; border-bottom:1px solid #dee2e6; display:flex; align-items:center; gap:6px; flex-shrink:0;">
            <span class="small fw-semibold text-muted me-1">ZOOM</span>
            <button class="btn btn-sm btn-outline-secondary" onclick="zoomOut()" title="Zoom out"><i class="fas fa-minus"></i></button>
            <span id="zoomLabel" class="small" style="min-width:3.5em; text-align:center;">100%</span>
            <button class="btn btn-sm btn-outline-secondary" onclick="zoomIn()" title="Zoom in"><i class="fas fa-plus"></i></button>
            <button class="btn btn-sm btn-outline-secondary" onclick="zoomReset()" title="Fit to window"><i class="fas fa-compress-arrows-alt"></i></button>
            <span class="small text-muted ms-2 d-none d-md-inline">Ctrl+Scroll to zoom</span>
        </div>

        <!-- Scroll area -->
        <div id="mapScrollContainer" style="flex:1; overflow:auto; background:#e9ecef; padding:16px;">
        <div id="mapWrapper" style="position:relative;">
            @if (Model.FloorPlan.FileType == "pdf")
            {
                <canvas id="pdfCanvas" style="display:block; width:100%; height:auto; border-radius:8px; box-shadow:0 4px 20px rgba(0,0,0,0.2);"></canvas>
            }
            else
            {
                <img id="floorPlanImg" src="/uploads/floorplans/@Model.FloorPlan.StoredFileName"
                     style="display:block; width:100%; height:auto; border-radius:8px; box-shadow:0 4px 20px rgba(0,0,0,0.2);"
                     alt="Floor Plan" />
            }
            <svg id="mapOverlay" style="position:absolute; top:0; left:0; width:100%; height:100%;"></svg>
        </div>
        </div><!-- /mapScrollContainer -->
    </div><!-- /map column -->

</div>

<!-- ── Add Pin Modal ── -->
<div class="modal fade" id="addPinModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#003087; color:white;">
                <h5 class="modal-title"><i class="fas fa-map-marker-alt me-2"></i>New Location Pin</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Location Name <span class="text-danger">*</span></label>
                    <input type="text" id="newPinName" class="form-control" maxlength="200" />
                    <div class="invalid-feedback">Name is required.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea id="newPinDesc" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmAddPin" class="btn btn-primary">
                    <i class="fas fa-map-marker-alt me-1"></i>Place Pin
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.FloorPlan.FileType == "pdf")
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    }
    <script>
        // ---- State ----
        var mode = 'add';
        var selectedPinId = null;
        var pendingX = 0, pendingY = 0;
        var pendingUnmappedId = null;
        var pinRadius = @Model.FloorPlan.PinRadius;
        var floorPlanId = @Model.FloorPlan.Id;
        var isDragging = false;
        var dragPinId = null;
        var dragStartX = 0, dragStartY = 0;
        var dragMoved = false;

        // ---- Pin data from server ----
        var pins = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.MappedLocations.Select(l => new {
                id = l.Id,
                name = l.Name,
                description = l.Description ?? "",
                qrCode = l.QrCode,
                x = l.MapX,
                y = l.MapY
            })
        ));

        // ---- Waypoint state ----
        var segmentWaypoints = {}; // "fromId-toId" -> [{x,y}, ...]
        var dragWpSegKey = null, dragWpIndex = -1, dragWpMoved = false;
        (function() {
            var raw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Waypoints,
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            raw.forEach(function(w) {
                var key = w.fromLocationId + '-' + w.toLocationId;
                if (!segmentWaypoints[key]) segmentWaypoints[key] = [];
                segmentWaypoints[key][w.orderIndex] = { x: w.x, y: w.y };
            });
            // compact sparse arrays
            Object.keys(segmentWaypoints).forEach(function(k) {
                segmentWaypoints[k] = segmentWaypoints[k].filter(Boolean);
            });
        })();

        function getCsrf() {
            var el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        // ---- SVG rendering ----
        var svg = document.getElementById('mapOverlay');
        var wrapper = document.getElementById('mapWrapper');

        // ---- Arrow helpers ----
        function clipToward(from, to, dist) {
            var dx = to.x - from.x, dy = to.y - from.y;
            var len = Math.sqrt(dx * dx + dy * dy);
            if (len < 1) return { x: from.x, y: from.y };
            return { x: from.x + dx / len * dist, y: from.y + dy / len * dist };
        }

        function createArrowDefs() {
            var defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
            var marker = document.createElementNS('http://www.w3.org/2000/svg', 'marker');
            marker.setAttribute('id', 'patrol-arrow');
            marker.setAttribute('viewBox', '0 0 10 8');
            marker.setAttribute('refX', '9');
            marker.setAttribute('refY', '4');
            marker.setAttribute('markerWidth', '10');
            marker.setAttribute('markerHeight', '8');
            marker.setAttribute('orient', 'auto');
            marker.setAttribute('markerUnits', 'userSpaceOnUse');
            var poly = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            poly.setAttribute('d', 'M 0 0 L 10 4 L 0 8 z');
            poly.setAttribute('fill', '#0d6efd');
            marker.appendChild(poly);
            defs.appendChild(marker);
            svg.appendChild(defs);
        }

        // Catmull-Rom spline → cubic Bezier path. Produces smooth curves through all points.
        // With 2 points it falls back to a straight line.
        function smoothPath(pts) {
            if (pts.length < 2) return '';
            if (pts.length === 2)
                return 'M ' + pts[0].x.toFixed(1) + ' ' + pts[0].y.toFixed(1) +
                       ' L ' + pts[1].x.toFixed(1) + ' ' + pts[1].y.toFixed(1);
            var ps = [pts[0]].concat(pts).concat([pts[pts.length - 1]]);
            var d = 'M ' + ps[1].x.toFixed(1) + ' ' + ps[1].y.toFixed(1);
            for (var i = 1; i < ps.length - 2; i++) {
                var p0 = ps[i - 1], p1 = ps[i], p2 = ps[i + 1], p3 = ps[i + 2];
                var cp1x = p1.x + (p2.x - p0.x) / 6;
                var cp1y = p1.y + (p2.y - p0.y) / 6;
                var cp2x = p2.x - (p3.x - p1.x) / 6;
                var cp2y = p2.y - (p3.y - p1.y) / 6;
                d += ' C ' + cp1x.toFixed(1) + ' ' + cp1y.toFixed(1) +
                     ' ' + cp2x.toFixed(1) + ' ' + cp2y.toFixed(1) +
                     ' ' + p2.x.toFixed(1) + ' ' + p2.y.toFixed(1);
            }
            return d;
        }

        function renderArrows(w, h) {
            var arrowOffset = pinRadius + 10;
            for (var i = 0; i < pins.length - 1; i++) {
                var pA = pins[i], pB = pins[i + 1];
                var key = pA.id + '-' + pB.id;
                var wpts = (segmentWaypoints[key] || []).map(function(wp) {
                    return { x: wp.x * w, y: wp.y * h };
                });
                var all = [{ x: pA.x * w, y: pA.y * h }].concat(wpts).concat([{ x: pB.x * w, y: pB.y * h }]);
                var pStart = clipToward(all[0], all[1] || all[0], pinRadius + 2);
                var last = all.length - 1;
                var pEnd = clipToward(all[last], all[last - 1] || all[last], arrowOffset);
                var dx = pEnd.x - pStart.x, dy = pEnd.y - pStart.y;
                if (wpts.length === 0 && Math.sqrt(dx * dx + dy * dy) < 5) continue;
                var pts = [pStart].concat(wpts).concat([pEnd]);
                var pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                pathEl.setAttribute('d', smoothPath(pts));
                pathEl.setAttribute('stroke', '#0d6efd');
                pathEl.setAttribute('stroke-width', '2');
                pathEl.setAttribute('fill', 'none');
                pathEl.setAttribute('marker-end', 'url(#patrol-arrow)');
                pathEl.setAttribute('pointer-events', 'none');
                svg.appendChild(pathEl);
            }
        }

        // Transparent wide hit areas over each arrow segment — click anywhere on the line to add a bend.
        function renderArrowClickTargets(w, h) {
            for (var i = 0; i < pins.length - 1; i++) {
                var pA = pins[i], pB = pins[i + 1];
                var key = pA.id + '-' + pB.id;
                var wpts = segmentWaypoints[key] || [];
                var allNorm = [{ x: pA.x, y: pA.y }].concat(wpts).concat([{ x: pB.x, y: pB.y }]);
                for (var j = 0; j < allNorm.length - 1; j++) {
                    (function(segKey, insertIdx, ptA, ptB) {
                        var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                        line.setAttribute('x1', ptA.x * w);
                        line.setAttribute('y1', ptA.y * h);
                        line.setAttribute('x2', ptB.x * w);
                        line.setAttribute('y2', ptB.y * h);
                        line.setAttribute('stroke', 'transparent');
                        line.setAttribute('stroke-width', '14');
                        line.setAttribute('pointer-events', 'stroke');
                        line.style.cursor = 'copy';
                        var t = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                        t.textContent = 'Click to add bend point';
                        line.appendChild(t);
                        line.addEventListener('click', function(e) {
                            e.stopPropagation();
                            var rect = wrapper.getBoundingClientRect();
                            var nx = (e.clientX - rect.left) / rect.width;
                            var ny = (e.clientY - rect.top) / rect.height;
                            if (!segmentWaypoints[segKey]) segmentWaypoints[segKey] = [];
                            segmentWaypoints[segKey].splice(insertIdx, 0, { x: nx, y: ny });
                            renderPins();
                            saveSegmentWaypoints(segKey);
                        });
                        svg.appendChild(line);
                    })(key, j, allNorm[j], allNorm[j + 1]);
                }
            }
        }

        function renderWaypointHandles(w, h) {
            for (var i = 0; i < pins.length - 1; i++) {
                var pA = pins[i], pB = pins[i + 1];
                var key = pA.id + '-' + pB.id;
                var wpts = segmentWaypoints[key] || [];
                wpts.forEach(function(wp, wpIdx) {
                    (function(segKey, wpIndex) {
                        var cx = wp.x * w, cy = wp.y * h;
                        var handle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                        handle.setAttribute('cx', cx);
                        handle.setAttribute('cy', cy);
                        handle.setAttribute('r', 7);
                        handle.setAttribute('fill', '#fd7e14');
                        handle.setAttribute('stroke', 'white');
                        handle.setAttribute('stroke-width', '2');
                        handle.style.cursor = 'grab';
                        var t = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                        t.textContent = 'Drag to move. Double-click to delete.';
                        handle.appendChild(t);
                        handle.addEventListener('mousedown', function(e) {
                            e.stopPropagation();
                            dragWpSegKey = segKey;
                            dragWpIndex = wpIndex;
                            dragStartX = e.clientX;
                            dragStartY = e.clientY;
                        });
                        handle.addEventListener('click', function(e) {
                            e.stopPropagation(); // prevent SVG background click from calling renderPins() mid-dblclick
                        });
                        handle.addEventListener('dblclick', function(e) {
                            e.stopPropagation();
                            segmentWaypoints[segKey].splice(wpIndex, 1);
                            if (segmentWaypoints[segKey].length === 0) delete segmentWaypoints[segKey];
                            renderPins();
                            saveSegmentWaypoints(segKey);
                        });
                        svg.appendChild(handle);
                    })(key, wpIdx);
                });
            }
        }

        function renderPins() {
            svg.innerHTML = '';
            var w = wrapper.offsetWidth;
            var h = wrapper.offsetHeight;
            svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);

            // Layer 1: arrows
            createArrowDefs();
            if (pins.length >= 2) renderArrows(w, h);

            // Layer 2: pins
            pins.forEach(function (pin, i) {
                var cx = pin.x * w;
                var cy = pin.y * h;

                var g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                g.dataset.id = pin.id;
                g.setAttribute('class', 'map-pin');
                g.style.cursor = 'grab';

                var isSelected = pin.id === selectedPinId;

                var circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                circle.setAttribute('cx', cx);
                circle.setAttribute('cy', cy);
                circle.setAttribute('r', pinRadius);
                circle.setAttribute('fill', isSelected ? '#ffc107' : '#003087');
                circle.setAttribute('stroke', isSelected ? '#856404' : 'white');
                circle.setAttribute('stroke-width', isSelected ? '3' : '2');

                var text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('x', cx);
                text.setAttribute('y', cy + pinRadius * 0.28);
                text.setAttribute('text-anchor', 'middle');
                text.setAttribute('fill', isSelected ? '#212529' : 'white');
                text.setAttribute('font-size', Math.round(pinRadius * 0.67));
                text.setAttribute('font-weight', 'bold');
                text.setAttribute('pointer-events', 'none');
                text.textContent = (i + 1).toString();

                var title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                title.textContent = pin.name + (pin.description ? '\n' + pin.description : '');

                g.appendChild(circle);
                g.appendChild(text);
                g.appendChild(title);

                g.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (!isDragging && mode !== 'route') selectPin(pin.id);
                });

                g.addEventListener('mousedown', function (e) {
                    e.stopPropagation();
                    if (mode === 'route') return; // don't drag pins in route mode
                    dragPinId = pin.id;
                    dragStartX = e.clientX;
                    dragStartY = e.clientY;
                });

                svg.appendChild(g);
            });

            // Layer 3: arrow click targets (on top of pins so route-mode clicks register)
            if (mode === 'route' && pins.length >= 2) renderArrowClickTargets(w, h);

            // Layer 4: waypoint drag handles (topmost so they're always draggable)
            if (mode === 'route' && pins.length >= 2) renderWaypointHandles(w, h);
        }

        // ---- Pin size ----
        var pinSizeSaveTimer = null;
        function onPinSizeChange(val) {
            pinRadius = val;
            document.getElementById('pinSizeSlider').value = val;
            document.getElementById('pinSizeNumber').value = val;
            renderPins();
            clearTimeout(pinSizeSaveTimer);
            pinSizeSaveTimer = setTimeout(function () {
                fetch('/Admin/SavePinSize', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]').value },
                    body: JSON.stringify({ floorPlanId: floorPlanId, pinRadius: val })
                });
            }, 600);
        }

        // ---- Drag to move pins and waypoints ----
        document.addEventListener('mousemove', function (e) {
            var rect = wrapper.getBoundingClientRect();
            var x = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
            var y = Math.min(1, Math.max(0, (e.clientY - rect.top) / rect.height));

            if (dragWpSegKey !== null) {
                var dx = Math.abs(e.clientX - dragStartX), dy = Math.abs(e.clientY - dragStartY);
                if (dx > 4 || dy > 4) {
                    dragWpMoved = true;
                    if (segmentWaypoints[dragWpSegKey]) {
                        segmentWaypoints[dragWpSegKey][dragWpIndex] = { x: x, y: y };
                        renderPins();
                    }
                }
                return;
            }

            if (dragPinId === null) return;
            var dx2 = Math.abs(e.clientX - dragStartX), dy2 = Math.abs(e.clientY - dragStartY);
            if (dx2 > 4 || dy2 > 4) {
                isDragging = true;
                dragMoved = true;
                var pin = pins.find(function (p) { return p.id === dragPinId; });
                if (pin) { pin.x = x; pin.y = y; }
                renderPins();
            }
        });

        document.addEventListener('mouseup', function (e) {
            if (dragWpSegKey !== null) {
                if (dragWpMoved) saveSegmentWaypoints(dragWpSegKey);
                dragWpSegKey = null;
                dragWpIndex = -1;
                dragWpMoved = false;
                return;
            }
            if (dragPinId !== null && dragMoved) {
                var pin = pins.find(function (p) { return p.id === dragPinId; });
                if (pin) saveMove(pin.id, pin.x, pin.y);
            }
            dragPinId = null;
            dragMoved = false;
            setTimeout(function () { isDragging = false; }, 50);
        });

        // ---- Click on SVG background ----
        svg.addEventListener('click', function (e) {
            if (isDragging) return;
            var rect = wrapper.getBoundingClientRect();
            var x = (e.clientX - rect.left) / rect.width;
            var y = (e.clientY - rect.top) / rect.height;
            x = Math.min(1, Math.max(0, x));
            y = Math.min(1, Math.max(0, y));

            if (pendingUnmappedId !== null) {
                placeUnmapped(pendingUnmappedId, x, y);
                return;
            }
            if (mode === 'add') {
                pendingX = x;
                pendingY = y;
                document.getElementById('newPinName').value = '';
                document.getElementById('newPinDesc').value = '';
                document.getElementById('newPinName').classList.remove('is-invalid');
                var modal = new bootstrap.Modal(document.getElementById('addPinModal'));
                modal.show();
            } else {
                selectedPinId = null;
                document.getElementById('selectedPanel').classList.add('d-none');
                renderPins();
            }
        });

        // ---- Mode ----
        function setMode(m) {
            mode = m;
            pendingUnmappedId = null;
            document.querySelectorAll('.unmapped-item').forEach(function (el) {
                el.classList.remove('border-primary', 'bg-light');
                el.style.borderColor = '';
            });
            document.getElementById('btnModeAdd').classList.toggle('active', m === 'add');
            document.getElementById('btnModeSelect').classList.toggle('active', m === 'select');
            document.getElementById('btnModeRoute').classList.toggle('active', m === 'route');
            if (m === 'route') {
                selectedPinId = null;
                document.getElementById('selectedPanel').classList.add('d-none');
                document.getElementById('statusMsg').textContent =
                    'Click anywhere on an arrow to add a bend. Drag orange handles to reposition. Double-click a handle to remove it.';
            } else {
                document.getElementById('statusMsg').textContent = m === 'add'
                    ? 'Click on map to add a new pin.'
                    : 'Click a pin to select and edit it.';
            }
            renderPins();
        }

        // ---- Select unmapped location ----
        function selectUnmapped(el) {
            document.querySelectorAll('.unmapped-item').forEach(function (e) {
                e.classList.remove('border-primary', 'bg-light');
                e.style.borderColor = '';
            });
            var id = parseInt(el.dataset.id);
            if (pendingUnmappedId === id) {
                pendingUnmappedId = null;
                document.getElementById('statusMsg').textContent = 'Click on the map to add a pin.';
                return;
            }
            pendingUnmappedId = id;
            el.style.borderColor = '#003087';
            el.classList.add('bg-light');
            document.getElementById('statusMsg').textContent = 'Now click on the map to place "' + el.dataset.name + '".';
        }

        async function placeUnmapped(locId, x, y) {
            var el = document.querySelector('.unmapped-item[data-id="' + locId + '"]');
            var response = await fetch('/Admin/AddMapPin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ floorPlanId: @Model.FloorPlan.Id, x: x, y: y, existingLocationId: locId, name: '', description: '' })
            });
            var data = await response.json();
            if (data.success) {
                pins.push({ id: data.locationId, name: data.name, description: data.description, qrCode: data.qrCode, x: data.x, y: data.y });
                if (el) el.remove();
                var count = document.getElementById('unmappedCount');
                count.textContent = parseInt(count.textContent) - 1;
                pendingUnmappedId = null;
                renderPins();
                document.getElementById('statusMsg').textContent = 'Pin placed.';
            } else {
                document.getElementById('statusMsg').textContent = 'Error placing pin.';
            }
        }

        // ---- Select pin for editing ----
        function selectPin(id) {
            selectedPinId = id;
            var pin = pins.find(function (p) { return p.id === id; });
            if (!pin) return;
            document.getElementById('editName').value = pin.name;
            document.getElementById('editDesc').value = pin.description;
            document.getElementById('selectedQr').textContent = pin.qrCode ? 'QR: ' + pin.qrCode : '';
            document.getElementById('selectedPanel').classList.remove('d-none');
            setMode('select');
            renderPins();
        }

        async function saveSelectedPin() {
            if (!selectedPinId) return;
            var name = document.getElementById('editName').value.trim();
            if (!name) { alert('Name is required.'); return; }
            var desc = document.getElementById('editDesc').value.trim();
            var response = await fetch('/Admin/UpdateMapPin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ locationId: selectedPinId, name: name, description: desc })
            });
            var data = await response.json();
            if (data.success) {
                var pin = pins.find(function (p) { return p.id === selectedPinId; });
                if (pin) { pin.name = data.name; pin.description = data.description; }
                renderPins();
                document.getElementById('statusMsg').textContent = 'Pin updated.';
            } else {
                document.getElementById('statusMsg').textContent = 'Error saving pin.';
            }
        }

        async function removeSelectedPin() {
            if (!selectedPinId) return;
            if (!confirm('Remove this pin from the map? The location will not be deleted.')) return;
            var id = selectedPinId;
            var pin = pins.find(function (p) { return p.id === id; });
            var response = await fetch('/Admin/RemoveMapPin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ locationId: id })
            });
            var data = await response.json();
            if (data.success) {
                pins = pins.filter(function (p) { return p.id !== id; });
                Object.keys(segmentWaypoints).forEach(function(key) {
                    var parts = key.split('-');
                    if (parseInt(parts[0]) === id || parseInt(parts[1]) === id) delete segmentWaypoints[key];
                });
                selectedPinId = null;
                document.getElementById('selectedPanel').classList.add('d-none');
                if (pin) {
                    var div = document.createElement('div');
                    div.className = 'unmapped-item p-2 mb-1 rounded border bg-white small';
                    div.dataset.id = pin.id;
                    div.dataset.name = pin.name;
                    div.dataset.desc = pin.description;
                    div.style.cursor = 'pointer';
                    div.onclick = function () { selectUnmapped(this); };
                    div.innerHTML = '<i class="fas fa-map-marker text-muted me-1"></i>' + pin.name;
                    document.getElementById('unmappedList').appendChild(div);
                    var count = document.getElementById('unmappedCount');
                    count.textContent = parseInt(count.textContent) + 1;
                }
                renderPins();
                document.getElementById('statusMsg').textContent = 'Pin removed.';
            } else {
                document.getElementById('statusMsg').textContent = 'Error removing pin.';
            }
        }

        var dirtySegments = new Set();
        var saveStatusTimer = null;

        function setSaveStatus(msg, cssClass) {
            var el = document.getElementById('statusMsg');
            el.textContent = msg;
            el.className = 'small ' + cssClass;
            clearTimeout(saveStatusTimer);
            if (cssClass === 'text-success') {
                saveStatusTimer = setTimeout(function() {
                    el.textContent = 'Route mode: click arrow to add bend, drag handle to move, double-click to delete.';
                    el.className = 'small text-muted';
                }, 2000);
            }
        }

        async function saveSegmentWaypoints(segKey) {
            var parts = segKey.split('-');
            var wps = (segmentWaypoints[segKey] || []).filter(Boolean);
            var payload = {
                floorPlanId: floorPlanId,
                fromLocationId: parseInt(parts[0]),
                toLocationId: parseInt(parts[1]),
                waypoints: wps
            };
            var body = JSON.stringify(payload);
            console.log('[SP] saveSegmentWaypoints SENDING', payload);
            dirtySegments.add(segKey);
            setSaveStatus('Saving route...', 'text-muted');
            try {
                var resp = await fetch('/Admin/SaveSegmentWaypoints', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrf() },
                    body: body,
                    keepalive: true
                });
                if (resp.ok) {
                    var data = await resp.json();
                    console.log('[SP] saveSegmentWaypoints RESPONSE', data);
                    if (data.success) {
                        dirtySegments.delete(segKey);
                        setSaveStatus('Route saved (' + data.savedCount + ' bends).', 'text-success');
                        // Verify DB immediately
                        verifyWaypoints();
                    } else {
                        setSaveStatus('Server returned failure. Check console.', 'text-danger');
                        console.error('[SP] saveSegmentWaypoints: success=false', data);
                    }
                } else {
                    setSaveStatus('Save failed (HTTP ' + resp.status + '). Check console.', 'text-danger');
                    console.error('[SP] SaveSegmentWaypoints HTTP error', resp.status, await resp.text());
                }
            } catch (e) {
                setSaveStatus('Save failed: ' + e.message, 'text-danger');
                console.error('[SP] SaveSegmentWaypoints exception', e);
            }
        }

        async function verifyWaypoints() {
            try {
                var resp = await fetch('/Admin/GetWaypoints?floorPlanId=' + floorPlanId);
                var data = await resp.json();
                console.log('[SP] DB contains ' + data.length + ' waypoints for floorPlanId=' + floorPlanId + ':', data);
            } catch (e) {
                console.warn('[SP] verifyWaypoints failed', e);
            }
        }

        function buildSegmentBody(segKey) {
            var parts = segKey.split('-');
            var wps = (segmentWaypoints[segKey] || []).filter(Boolean);
            return JSON.stringify({
                floorPlanId: floorPlanId,
                fromLocationId: parseInt(parts[0]),
                toLocationId: parseInt(parts[1]),
                waypoints: wps
            });
        }

        function flushDirtySegments() {
            // Include any in-progress drag that never completed
            if (dragWpSegKey !== null && dragWpMoved) dirtySegments.add(dragWpSegKey);
            if (!dirtySegments.size) return;
            dirtySegments.forEach(function(segKey) {
                // sendBeacon: browser-guaranteed delivery even during page unload.
                // No CSRF header needed — endpoint has no [ValidateAntiForgeryToken].
                // Same-origin → auth cookie is automatically included.
                var sent = navigator.sendBeacon(
                    '/Admin/SaveSegmentWaypoints',
                    new Blob([buildSegmentBody(segKey)], { type: 'application/json' })
                );
                if (!sent) {
                    // Payload too large for sendBeacon; fall back to keepalive fetch
                    fetch('/Admin/SaveSegmentWaypoints', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrf() },
                        body: buildSegmentBody(segKey),
                        keepalive: true
                    });
                }
            });
        }

        window.addEventListener('beforeunload', flushDirtySegments);
        document.addEventListener('visibilitychange', function() {
            if (document.visibilityState === 'hidden') flushDirtySegments();
        });

        async function saveMove(id, x, y) {
            await fetch('/Admin/MoveMapPin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ locationId: id, x: x, y: y })
            });
        }

        // ---- Add Pin modal confirm ----
        document.getElementById('confirmAddPin').addEventListener('click', async function () {
            var name = document.getElementById('newPinName').value.trim();
            if (!name) {
                document.getElementById('newPinName').classList.add('is-invalid');
                return;
            }
            document.getElementById('newPinName').classList.remove('is-invalid');
            var desc = document.getElementById('newPinDesc').value.trim();
            var response = await fetch('/Admin/AddMapPin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ floorPlanId: @Model.FloorPlan.Id, x: pendingX, y: pendingY, name: name, description: desc, existingLocationId: null })
            });
            var data = await response.json();
            if (data.success) {
                pins.push({ id: data.locationId, name: data.name, description: data.description, qrCode: data.qrCode, x: data.x, y: data.y });
                bootstrap.Modal.getInstance(document.getElementById('addPinModal')).hide();
                renderPins();
                document.getElementById('statusMsg').textContent = 'Pin added.';
            } else {
                document.getElementById('statusMsg').textContent = 'Error adding pin.';
            }
        });

        // ---- Also allow Enter key in new pin name field ----
        document.getElementById('newPinName').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') document.getElementById('confirmAddPin').click();
        });

        // ---- Initialise ----
        @if (Model.FloorPlan.FileType == "pdf")
        {
            <text>
            var pdfjsLib = window['pdfjs-dist/build/pdf'];
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
            pdfjsLib.getDocument('/uploads/floorplans/@Model.FloorPlan.StoredFileName').promise.then(function (pdf) {
                pdf.getPage(1).then(function (page) {
                    var viewport = page.getViewport({ scale: 2 });
                    var canvas = document.getElementById('pdfCanvas');
                    // Set attribute dimensions (rendering resolution)
                    canvas.width  = viewport.width;
                    canvas.height = viewport.height;
                    // CSS constrains display size; height:auto maintains aspect ratio
                    canvas.style.width  = '100%';
                    canvas.style.height = 'auto';
                    page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise.then(function () {
                        requestAnimationFrame(renderPins);
                    });
                });
            });
            </text>
        }
        else
        {
            <text>
            var img = document.getElementById('floorPlanImg');
            if (img.complete) {
                requestAnimationFrame(renderPins);
            } else {
                img.addEventListener('load', function() { requestAnimationFrame(renderPins); });
            }
            </text>
        }

        // ---- Zoom ----
        var zoomLevel = 1.0;
        var mapScrollContainer = document.getElementById('mapScrollContainer');

        function applyZoom(newZoom) {
            newZoom = Math.round(Math.min(5.0, Math.max(0.5, newZoom)) * 20) / 20;
            zoomLevel = newZoom;
            var baseWidth = mapScrollContainer.clientWidth - 32; // 16px padding each side
            wrapper.style.width = Math.round(baseWidth * zoomLevel) + 'px';
            document.getElementById('zoomLabel').textContent = Math.round(zoomLevel * 100) + '%';
            renderPins();
        }

        function zoomIn()    { applyZoom(zoomLevel + 0.25); }
        function zoomOut()   { applyZoom(zoomLevel - 0.25); }
        function zoomReset() { applyZoom(1.0); }

        // Ctrl+Scroll: zoom toward cursor position
        mapScrollContainer.addEventListener('wheel', function(e) {
            if (!e.ctrlKey) return;
            e.preventDefault();
            var delta = e.deltaY < 0 ? 0.25 : -0.25;
            var containerRect = mapScrollContainer.getBoundingClientRect();
            var mouseContentX = e.clientX - containerRect.left + mapScrollContainer.scrollLeft;
            var mouseContentY = e.clientY - containerRect.top  + mapScrollContainer.scrollTop;
            var oldWidth  = wrapper.offsetWidth;
            var oldHeight = wrapper.offsetHeight;
            applyZoom(zoomLevel + delta);
            var newWidth  = wrapper.offsetWidth;
            if (newWidth !== oldWidth) {
                var scale = newWidth / oldWidth;
                mapScrollContainer.scrollLeft = mouseContentX * scale - (e.clientX - containerRect.left);
                mapScrollContainer.scrollTop  = mouseContentY * scale - (e.clientY - containerRect.top);
            }
        }, { passive: false });

        // Size the editor to exactly fill the remaining viewport below the page headers
        (function() {
            var outer = document.getElementById('editorOuter');
            function fitEditor() {
                outer.style.height = (window.innerHeight - outer.getBoundingClientRect().top) + 'px';
            }
            fitEditor();
            window.addEventListener('resize', fitEditor);
        })();

        // Re-render on window resize; reapply zoom to keep wrapper width in sync
        window.addEventListener('resize', function() {
            if (zoomLevel > 1.0) applyZoom(zoomLevel); else renderPins();
        });

        function confirmDeleteFloorPlan() {
            if (confirm('Delete this floor plan? This will remove it and unpin all locations from it. This cannot be undone.')) {
                document.getElementById('deleteFloorPlanForm').submit();
            }
        }
    </script>
}
