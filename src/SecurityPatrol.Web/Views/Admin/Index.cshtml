@model SecurityPatrol.Web.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <div class="container">
        <h2 class="mb-0"><i class="fas fa-cogs me-2"></i>Admin Dashboard</h2>
        <small class="opacity-75">DRH Security Patrol Management</small>
    </div>
</div>

<div class="container">
    <div class="row g-4">
        @{
            var missedColor = Model.MissedLocationsToday > 0 ? "text-danger" : "text-muted";
            var sections = new[]
            {
                new { Icon = "fas fa-users",          Title = "User Admin",         Desc = "Create and manage officer and auditor accounts",    Link = "/Admin/Users",             Color = "text-primary",   Stat = $"{Model.TotalUsers} users · {Model.ActiveOfficers} active officers",              StatColor = "text-primary" },
                new { Icon = "fas fa-building",       Title = "Site Admin",         Desc = "Manage buildings, floors, and scan locations",      Link = "/SiteAdmin",               Color = "text-info",      Stat = $"{Model.TotalBuildings} buildings · {Model.TotalLocations} locations",             StatColor = "text-info" },
                new { Icon = "fas fa-calendar-alt",   Title = "Schedules",          Desc = "Create and manage patrol schedules",                Link = "/Admin/Schedules",         Color = "text-success",   Stat = $"{Model.PatrolsToday} patrols today · {Model.ScheduledPatrolsToday} scheduled", StatColor = "text-success" },
                new { Icon = "fas fa-route",          Title = "Patrol Routes",      Desc = "Define patrol routes and location order",           Link = "/Admin/Routes",            Color = "text-warning",   Stat = $"{Model.MissedLocationsToday} missed today",                                    StatColor = missedColor },
                new { Icon = "fas fa-qrcode",         Title = "QR Codes",           Desc = "Generate and print QR codes for locations",         Link = "/Admin/QrCodes",           Color = "text-dark",      Stat = "",                                                                              StatColor = "" },
                new { Icon = "fas fa-clipboard-list", Title = "Schedule Templates", Desc = "Define reusable schedule templates",                Link = "/Admin/ScheduleTemplates", Color = "text-secondary", Stat = "",                                                                              StatColor = "" },
                new { Icon = "fas fa-bell",           Title = "Messages",           Desc = "Post messages visible to all officers",             Link = "/Admin/Messages",          Color = "text-danger",    Stat = "",                                                                              StatColor = "" },
                new { Icon = "fas fa-chart-bar",      Title = "Reports",            Desc = "Patrol history and role-based reports",             Link = "/Report",                  Color = "text-primary",   Stat = "",                                                                              StatColor = "" }
            };
        }
        @foreach (var s in sections)
        {
            <div class="col-md-3 col-6">
                <a href="@s.Link" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm admin-card" style="transition: transform 0.15s;">
                        <div class="card-body text-center py-4">
                            <i class="@s.Icon fa-2x @s.Color mb-3"></i>
                            <h6 class="fw-bold mb-1">@s.Title</h6>
                            <p class="small text-muted mb-0">@s.Desc</p>
                            @if (!string.IsNullOrEmpty(s.Stat))
                            {
                                <p class="small fw-semibold mt-2 mb-0 @s.StatColor">@s.Stat</p>
                            }
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.admin-card').forEach(function(card) {
            card.addEventListener('mouseenter', function() { this.style.transform = 'translateY(-4px)'; });
            card.addEventListener('mouseleave', function() { this.style.transform = 'translateY(0)'; });
        });
    </script>
}
