@model List<SecurityPatrol.Web.Models.AdminMessage>
@{
    ViewData["Title"] = "Admin Messages";
}

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-bell me-2"></i>Admin Messages</h2>
            <small class="opacity-75">Broadcast messages to all security officers</small>
        </div>
        <div class="d-flex gap-2">
            @await Html.PartialAsync("_DashboardButton")
            <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="fas fa-plus me-1"></i>New Message
            </button>
        </div>
    </div>
</div>

<div class="container">
    <div class="card">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Body</th>
                            <th>Created By</th>
                            <th>Created</th>
                            <th>Expires</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var msg in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@msg.Title</td>
                                <td class="small text-muted" style="max-width:300px;">@(msg.Body.Length > 100 ? msg.Body[..100] + "..." : msg.Body)</td>
                                <td class="small">@msg.CreatedBy?.FullName</td>
                                <td class="small">@msg.CreatedAt.ToString("MM/dd/yyyy")</td>
                                <td class="small">@(msg.ExpiresAt?.ToString("MM/dd/yyyy") ?? "Never")</td>
                                <td>
                                    @if (msg.IsActive && (msg.ExpiresAt == null || msg.ExpiresAt > DateTime.UtcNow))
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            data-bs-toggle="modal" data-bs-target="#editModal"
                                            data-id="@msg.Id" data-title="@msg.Title"
                                            data-body="@msg.Body"
                                            data-active="@msg.IsActive.ToString().ToLower()"
                                            data-expires="@msg.ExpiresAt?.ToString("yyyy-MM-dd")">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form method="post" asp-action="DeleteMessage" class="d-inline"
                                          onsubmit="return confirm('Delete this message?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@msg.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-bell-slash fa-3x mb-3 opacity-25"></i>
                    <p>No messages created yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#003087; color:white;">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>New Message</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateMessage">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message Body <span class="text-danger">*</span></label>
                        <textarea name="body" class="form-control" rows="4" required maxlength="4000"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Expires At (optional)</label>
                        <input type="date" name="expiresAt" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Create Message
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#003087; color:white;">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Edit Message</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="EditMessage">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Title</label>
                        <input type="text" name="title" id="editTitle" class="form-control" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message Body</label>
                        <textarea name="body" id="editBody" class="form-control" rows="4" required maxlength="4000"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Expires At (optional)</label>
                        <input type="date" name="expiresAt" id="editExpires" class="form-control" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="isActive" id="editActive" class="form-check-input" value="true" />
                        <label class="form-check-label" for="editActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editModal').addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            document.getElementById('editId').value = btn.dataset.id;
            document.getElementById('editTitle').value = btn.dataset.title;
            document.getElementById('editBody').value = btn.dataset.body;
            document.getElementById('editExpires').value = btn.dataset.expires || '';
            document.getElementById('editActive').checked = btn.dataset.active === 'true';
        });
    </script>
}
