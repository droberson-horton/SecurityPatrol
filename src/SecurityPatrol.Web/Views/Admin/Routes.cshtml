@model SecurityPatrol.Web.ViewModels.PatrolRouteViewModel
@{
    ViewData["Title"] = "Patrol Routes";
}

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-route me-2"></i>Patrol Routes</h2>
            <small class="opacity-75">Define patrol routes and location ordering</small>
        </div>
        <div class="d-flex gap-2">
            @await Html.PartialAsync("_DashboardButton")
            <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#createRouteModal">
                <i class="fas fa-plus me-1"></i>New Route
            </button>
        </div>
    </div>
</div>

<div class="container">
    <div class="row g-4">
        @foreach (var route in Model.Routes)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 fw-bold">@route.Name</h6>
                            @if (!string.IsNullOrEmpty(route.Description))
                            {
                                <small class="text-muted">@route.Description</small>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (route.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                            <a asp-action="EditRoute" asp-route-id="@route.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            <form method="post" asp-action="DeleteRoute" class="d-inline"
                                  onsubmit="return confirm('Deactivate this route?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@route.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-ban"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (route.PatrolRouteLocations.Any())
                        {
                            <ol class="list-group list-group-flush list-group-numbered">
                                @foreach (var wrl in route.PatrolRouteLocations.OrderBy(x => x.OrderIndex))
                                {
                                    <li class="list-group-item py-2 small">
                                        <span class="fw-semibold">@wrl.Location.Name</span>
                                        <small class="text-muted ms-2">@wrl.Location.Building?.Name</small>
                                    </li>
                                }
                            </ol>
                        }
                        else
                        {
                            <div class="p-3 text-muted small text-center">
                                <i class="fas fa-map-marker-alt me-1"></i>No locations assigned yet.
                                <a asp-action="EditRoute" asp-route-id="@route.Id">Edit route to add locations.</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!Model.Routes.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="fas fa-route fa-3x mb-3 opacity-25"></i>
                <p>No routes created yet.</p>
            </div>
        }
    </div>
</div>

<!-- Create Route Modal -->
<div class="modal fade" id="createRouteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#003087; color:white;">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>New Route</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateRoute">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Route Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="description" class="form-control" rows="3" maxlength="1000"></textarea>
                    </div>
                    <p class="text-muted small"><i class="fas fa-info-circle me-1"></i>After creating, you'll be taken to the route editor to add locations.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Create & Edit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
