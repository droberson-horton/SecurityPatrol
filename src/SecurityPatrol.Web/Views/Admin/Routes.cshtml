@model SecurityPatrol.Web.ViewModels.PatrolRouteViewModel
@{
    ViewData["Title"] = "Patrol Routes";
}

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-route me-2"></i>Patrol Routes</h2>
            <small class="opacity-75">Define patrol routes and location ordering</small>
        </div>
        <div class="d-flex gap-2">
            @await Html.PartialAsync("_DashboardButton")
            <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#createRouteModal">
                <i class="fas fa-plus me-1"></i>New Route
            </button>
        </div>
    </div>
</div>

<form id="csrfForm">@Html.AntiForgeryToken()</form>

<div class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Routes.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-route fa-3x mb-3 opacity-25"></i>
            <p>No routes created yet.</p>
        </div>
    }
    else
    {
        <div id="routeAccordion">
            @foreach (var route in Model.Routes)
            {
                var collapseId = $"route-{route.Id}";
                <div class="accordion-item mb-3 border rounded shadow-sm" data-id="@route.Id">
                    <h2 class="accordion-header" id="heading-@route.Id">
                        <button class="accordion-button collapsed fw-semibold" type="button"
                                data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                aria-expanded="false" aria-controls="@collapseId">
                            <i class="fas fa-grip-vertical text-muted me-2 route-drag-handle" style="cursor:grab;" title="Drag to reorder"></i>
                            <i class="fas fa-route me-2 text-primary"></i>
                            @route.Name
                            @if (!string.IsNullOrEmpty(route.Description))
                            {
                                <small class="text-muted ms-2 fw-normal">— @route.Description</small>
                            }
                            @if (route.IsActive)
                            {
                                <span class="badge bg-success ms-3 fw-normal small">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-3 fw-normal small">Inactive</span>
                            }
                            <span class="badge bg-info text-dark ms-2 fw-normal small">@route.PatrolRouteLocations.Count location(s)</span>
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="heading-@route.Id">
                        <div class="accordion-body">
                            <div class="d-flex gap-2 mb-3">
                                <a asp-action="EditRoute" asp-route-id="@route.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit me-1"></i>Edit Route
                                </a>
                                <form method="post" asp-action="DeleteRoute" class="d-inline"
                                      onsubmit="return confirm('Deactivate this route?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@route.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-ban me-1"></i>Deactivate
                                    </button>
                                </form>
                            </div>

                            @if (route.PatrolRouteLocations.Any())
                            {
                                <ol class="list-group list-group-flush list-group-numbered">
                                    @foreach (var loc in route.PatrolRouteLocations.OrderBy(x => x.OrderIndex))
                                    {
                                        <li class="list-group-item py-2 small">
                                            <span class="fw-semibold">@loc.Location.Name</span>
                                            <small class="text-muted ms-2">@loc.Location.Building?.Name</small>
                                        </li>
                                    }
                                </ol>
                            }
                            else
                            {
                                <div class="text-muted small fst-italic">
                                    <i class="fas fa-map-marker-alt me-1"></i>No locations assigned yet.
                                    <a asp-action="EditRoute" asp-route-id="@route.Id">Edit route to add locations.</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create Route Modal -->
<div class="modal fade" id="createRouteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#003087; color:white;">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>New Route</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateRoute">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Route Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="description" class="form-control" rows="3" maxlength="1000"></textarea>
                    </div>
                    <p class="text-muted small"><i class="fas fa-info-circle me-1"></i>After creating, you'll be taken to the route editor to add locations.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Create & Edit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
    <script>
        var routeList = document.getElementById('routeAccordion');
        if (routeList) {
            new Sortable(routeList, {
                animation: 150,
                handle: '.route-drag-handle',
                ghostClass: 'bg-light',
                onEnd: function () {
                    var ids = Array.from(routeList.querySelectorAll('[data-id]'))
                        .map(function (el) { return parseInt(el.dataset.id); });

                    fetch('/Admin/ReorderRoutes', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify(ids)
                    });
                }
            });

            document.querySelectorAll('.route-drag-handle').forEach(function (handle) {
                handle.addEventListener('click', function (e) { e.stopPropagation(); });
            });
        }
    </script>
}
