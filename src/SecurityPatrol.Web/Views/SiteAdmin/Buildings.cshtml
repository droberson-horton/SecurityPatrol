@model SecurityPatrol.Web.ViewModels.BuildingsViewModel
@{
    ViewData["Title"] = "Buildings";
}

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-building me-2"></i>Buildings</h2>
            <small class="opacity-75">Manage facility buildings</small>
        </div>
        <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#createBuildingModal">
            <i class="fas fa-plus me-1"></i>New Building
        </button>
    </div>
</div>

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a href="/SiteAdmin/Buildings">Buildings</a></li>
                    <li class="breadcrumb-item"><a href="/SiteAdmin/Floors">Floors</a></li>
                    <li class="breadcrumb-item"><a href="/SiteAdmin/Locations">Locations</a></li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            @if (Model.Buildings.Any())
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Floors</th>
                            <th>Locations</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Buildings)
                        {
                            <tr>
                                <td class="fw-semibold">@b.Name</td>
                                <td class="small text-muted">@(b.Address ?? "-")</td>
                                <td><span class="badge bg-info">@b.Floors.Count</span></td>
                                <td><span class="badge bg-secondary">@b.Locations.Count</span></td>
                                <td>
                                    @if (b.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            data-bs-toggle="modal" data-bs-target="#editBuildingModal"
                                            data-id="@b.Id" data-name="@b.Name"
                                            data-address="@b.Address" data-active="@b.IsActive.ToString().ToLower()">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <a asp-controller="SiteAdmin" asp-action="Floors" asp-route-buildingId="@b.Id"
                                       class="btn btn-sm btn-outline-info me-1" title="Manage Floors">
                                        <i class="fas fa-layer-group"></i>
                                    </a>
                                    <form method="post" asp-action="DeleteBuilding" class="d-inline"
                                          onsubmit="return confirm('Deactivate this building?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-building fa-3x mb-3 opacity-25"></i>
                    <p>No buildings created yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createBuildingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#003087; color:white;">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>New Building</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateBuilding">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Building Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Address</label>
                        <input type="text" name="Address" class="form-control" maxlength="500" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="createActive" checked />
                        <label class="form-check-label" for="createActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editBuildingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#003087; color:white;">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Edit Building</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="EditBuilding">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editBuildingId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Building Name</label>
                        <input type="text" name="Name" id="editBuildingName" class="form-control" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Address</label>
                        <input type="text" name="Address" id="editBuildingAddress" class="form-control" maxlength="500" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editBuildingActive" />
                        <label class="form-check-label" for="editBuildingActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editBuildingModal').addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            document.getElementById('editBuildingId').value = btn.dataset.id;
            document.getElementById('editBuildingName').value = btn.dataset.name;
            document.getElementById('editBuildingAddress').value = btn.dataset.address || '';
            document.getElementById('editBuildingActive').checked = btn.dataset.active === 'true';
        });
    </script>
}
