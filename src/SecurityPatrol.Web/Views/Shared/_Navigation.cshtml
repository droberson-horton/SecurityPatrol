@using SecurityPatrol.Web.Models
@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string controller, string? action = null)
    {
        if (action != null)
            return currentController == controller && currentAction == action;
        return currentController == controller;
    }

    bool IsAdmin = User.HasClaim(ClaimTypes.Role, UserRole.Administrator.ToString());
    bool IsOfficer = User.HasClaim(ClaimTypes.Role, UserRole.SecurityOfficer.ToString());
    bool IsAuditor = User.HasClaim(ClaimTypes.Role, UserRole.Auditor.ToString());
}

<ul class="navbar-nav">
    @if (IsAdmin || IsOfficer)
    {
        <li class="nav-item">
            <a class="nav-link @(IsActive("Dashboard", "Officer") ? "active" : "")" href="/Dashboard/Officer">
                <i class="fas fa-tachometer-alt me-1"></i>Dashboard
            </a>
        </li>
    }

    @if (IsAuditor && !IsAdmin)
    {
        <li class="nav-item">
            <a class="nav-link @(IsActive("Audit", "Index") ? "active" : "")" href="/Audit">
                <i class="fas fa-tachometer-alt me-1"></i>Dashboard
            </a>
        </li>
    }

    @if (IsOfficer || IsAdmin)
    {
        <li class="nav-item">
            <a class="nav-link @(IsActive("Patrol", "Start") ? "active" : "")" href="/Patrol/Start">
                <i class="fas fa-walking me-1"></i>Start Patrol
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(IsActive("Patrol", "History") ? "active" : "")" href="/Patrol/History">
                <i class="fas fa-history me-1"></i>My History
            </a>
        </li>
    }

    @if (IsAdmin)
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle @(IsActive("Admin") || IsActive("SiteAdmin") ? "active" : "")"
               href="#" data-bs-toggle="dropdown">
                <i class="fas fa-cogs me-1"></i>Admin
            </a>
            <ul class="dropdown-menu dropdown-menu-dark">
                <li>
                    <a class="dropdown-item" href="/Admin">
                        <i class="fas fa-th me-2"></i>Admin Dashboard
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <a class="dropdown-item" href="/SiteAdmin">
                        <i class="fas fa-building me-2"></i>Site Admin
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/Admin/Users">
                        <i class="fas fa-users me-2"></i>User Admin
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/Admin/Schedules">
                        <i class="fas fa-calendar-alt me-2"></i>Schedules
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/Admin/ScheduleTemplates">
                        <i class="fas fa-clipboard-list me-2"></i>Schedule Templates
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/Admin/Routes">
                        <i class="fas fa-route me-2"></i>Patrol Routes
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/Admin/QrCodes">
                        <i class="fas fa-qrcode me-2"></i>QR Codes
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/Admin/Messages">
                        <i class="fas fa-bell me-2"></i>Messages
                    </a>
                </li>
            </ul>
        </li>
        <li class="nav-item">
            <a class="nav-link @(IsActive("Audit") ? "active" : "")" href="/Audit">
                <i class="fas fa-search me-1"></i>Audit
            </a>
        </li>
    }

    @if (IsAuditor || IsAdmin)
    {
        <li class="nav-item">
            <a class="nav-link @(IsActive("Report") ? "active" : "")" href="/Report">
                <i class="fas fa-chart-bar me-1"></i>Reports
            </a>
        </li>
        @if (IsAuditor && !IsAdmin)
        {
            <li class="nav-item">
                <a class="nav-link @(IsActive("Audit", "PatrolHistory") ? "active" : "")" href="/Audit/PatrolHistory">
                    <i class="fas fa-history me-1"></i>Patrol History
                </a>
            </li>
        }
    }
</ul>
