@model SecurityPatrol.Web.ViewModels.PatrolScanViewModel
@{
    ViewData["Title"] = "Scan Result";
}

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0"><i class="fas fa-map-marker-check me-2"></i>Location Scanned</h2>
            <small class="opacity-75">@Model.ScannedAt.ToTzString(Model.TimeZoneId, "HH:mm:ss") &mdash; @Model.BuildingName</small>
        </div>
        @await Html.PartialAsync("_DashboardButton")
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card mb-4 border-success">
                <div class="card-header bg-success text-white">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle fa-2x me-3"></i>
                        <div>
                            <h5 class="mb-0">@Model.LocationName</h5>
                            <small>
                                @Model.BuildingName
                                @if (!string.IsNullOrEmpty(Model.FloorName))
                                {
                                    <span> / @Model.FloorName</span>
                                }
                            </small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center g-3">
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <i class="fas fa-building text-primary mb-2"></i>
                                <div class="small fw-semibold">Building</div>
                                <div class="small text-muted">@Model.BuildingName</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <i class="fas fa-layer-group text-primary mb-2"></i>
                                <div class="small fw-semibold">Floor</div>
                                <div class="small text-muted">@(Model.FloorName ?? "N/A")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header" style="background:#003087; color:white;">
                    <h6 class="mb-0"><i class="fas fa-sticky-note me-2"></i>Add Note</h6>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Note">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="patrolScanId" value="@Model.PatrolScanId" />
                        <input type="hidden" name="patrolId" value="@Model.PatrolId" />
                        <div class="mb-3">
                            <textarea name="note" class="form-control" rows="3"
                                      placeholder="Enter any observations, incidents, or notes..."
                                      id="noteTextarea">@Model.ExistingNotes</textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="voiceBtn">
                                <i class="fas fa-microphone me-1"></i>Use Microphone
                            </button>
                            <button type="submit" class="btn btn-primary btn-sm ms-auto">
                                <i class="fas fa-save me-1"></i>Save Note
                            </button>
                        </div>
                        <div id="voiceStatus" class="text-muted small mt-2 d-none">
                            <i class="fas fa-circle text-danger me-1 blink"></i>Listening... Speak now.
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header" style="background:#003087; color:white;">
                    <h6 class="mb-0"><i class="fas fa-camera me-2"></i>Photo</h6>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <div class="mb-3 text-center">
                            <img src="@Model.PhotoPath" alt="Patrol scan photo" class="img-thumbnail" style="max-height: 200px;" />
                        </div>
                    }
                    <form method="post" asp-action="UploadPhoto" enctype="multipart/form-data" id="photoUploadForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="patrolScanId" value="@Model.PatrolScanId" />
                        <input type="hidden" name="patrolId" value="@Model.PatrolId" />

                        <!-- Single submitted input (no capture — populated by either button below) -->
                        <input type="file" name="photo" id="photoInput" accept="image/*" class="d-none" />
                        <!-- Camera-only trigger — not submitted (no name) -->
                        <input type="file" id="photoCameraInput" accept="image/*" capture="environment" class="d-none" />

                        <div class="d-grid gap-2 mb-3">
                            <button type="button" class="btn btn-primary" id="takePhotoBtn">
                                <i class="fas fa-camera me-2"></i>Take Photo
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="chooseGalleryBtn">
                                <i class="fas fa-images me-1"></i>Choose from Gallery
                            </button>
                        </div>

                        <img id="photoPreview" class="d-none img-thumbnail w-100 mb-3" style="max-height:240px; object-fit:contain;" alt="Preview" />

                        <button type="submit" class="btn btn-success w-100 d-none" id="uploadBtn">
                            <i class="fas fa-upload me-1"></i>Upload Photo
                        </button>
                    </form>
                </div>
            </div>

            <div class="d-grid">
                <a asp-controller="Patrol" asp-action="Active" asp-route-patrolId="@Model.PatrolId"
                   class="btn btn-success btn-lg">
                    <i class="fas fa-arrow-right me-2"></i>Continue Patrol
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        @@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
        .blink { animation: blink 1s infinite; }
    </style>
}

@section Scripts {
    <script>
        var voiceBtn = document.getElementById('voiceBtn');
        var voiceStatus = document.getElementById('voiceStatus');
        var noteTextarea = document.getElementById('noteTextarea');
        var recognition = null;

        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.interimResults = false;
            recognition.lang = 'en-US';

            recognition.onresult = function (event) {
                var transcript = event.results[0][0].transcript;
                noteTextarea.value = (noteTextarea.value ? noteTextarea.value + ' ' : '') + transcript;
                voiceStatus.classList.add('d-none');
                voiceBtn.innerHTML = '<i class="fas fa-microphone me-1"></i>Use Microphone';
            };

            recognition.onerror = function () {
                voiceStatus.classList.add('d-none');
                voiceBtn.innerHTML = '<i class="fas fa-microphone me-1"></i>Use Microphone';
            };

            recognition.onend = function () {
                voiceStatus.classList.add('d-none');
                voiceBtn.innerHTML = '<i class="fas fa-microphone me-1"></i>Use Microphone';
            };

            voiceBtn.addEventListener('click', function () {
                if (recognition) {
                    recognition.start();
                    voiceStatus.classList.remove('d-none');
                    voiceBtn.innerHTML = '<i class="fas fa-stop me-1"></i>Stop';
                }
            });
        } else {
            voiceBtn.disabled = true;
            voiceBtn.title = 'Speech recognition not supported in this browser';
        }

        // ── Photo capture / gallery ──────────────────────────────────────────
        function onPhotoSelected(file) {
            if (!file) return;
            var url = URL.createObjectURL(file);
            var preview = document.getElementById('photoPreview');
            preview.src = url;
            preview.classList.remove('d-none');
            preview.onload = function () { URL.revokeObjectURL(url); };
            document.getElementById('uploadBtn').classList.remove('d-none');
        }

        function copyToMainInput(file) {
            // Use DataTransfer to assign the file to the named input that the form submits.
            var dt = new DataTransfer();
            dt.items.add(file);
            document.getElementById('photoInput').files = dt.files;
            onPhotoSelected(file);
        }

        document.getElementById('takePhotoBtn').addEventListener('click', function () {
            document.getElementById('photoCameraInput').click();
        });

        document.getElementById('chooseGalleryBtn').addEventListener('click', function () {
            document.getElementById('photoInput').click();
        });

        // Camera capture — copy file into the named input before previewing
        document.getElementById('photoCameraInput').addEventListener('change', function () {
            if (this.files[0]) copyToMainInput(this.files[0]);
        });

        // Gallery — file goes directly into the named input; just show preview
        document.getElementById('photoInput').addEventListener('change', function () {
            onPhotoSelected(this.files[0]);
        });
    </script>
}
